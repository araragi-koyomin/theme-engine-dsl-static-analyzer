<?xml version="1.0" encoding="utf-8"?>
<ChargingSkin screenWidth="1080">
    <Var name="charge_pct" type="number" expression="#battery_level"/>
    <Var name="charge_pct" type="string" expression="'full'"/>
    <Image name="bolt" x="0" y="0" width="100" height="100"
           alpha="500" src="bolt.png" srcExp="@charge_icon"/>
    <Trigger action="click">
        <VideoCommand name="vid" play="1" sound="1"/>
    </Trigger>
    <Group name="container" x="0" y="0" width="1080" height="500">
        <Button name="nested_btn"/>
    </Group>
</ChargingSkin>
