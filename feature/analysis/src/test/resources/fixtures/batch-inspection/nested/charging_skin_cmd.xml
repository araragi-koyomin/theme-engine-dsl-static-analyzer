<?xml version="1.0" encoding="utf-8"?>
<ChargingSkin screenWidth="1080">
    <Var name="charge_pct" type="number" expression="#battery_level"/>
    <Image name="bolt" x="0" y="0" width="100" height="100" alpha="500" src="bolt.png"/>
    <Trigger action="click">
        <VideoCommand name="vid" play="1" sound="1"/>
    </Trigger>
</ChargingSkin>
