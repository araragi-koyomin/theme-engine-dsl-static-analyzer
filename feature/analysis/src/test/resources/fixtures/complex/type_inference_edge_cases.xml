<?xml version="1.0" encoding="utf-8"?>
<Lockscreen frameRate="60" screenWidth="1080">
    <Var name="num_or_str" type="number" expression="ifelse(#touch_x > 500, 100, 'string_branch')"/>
    <Var name="str_var" type="string" const="true" expression="'I am a string'"/>
    <Var name="valid_num" type="number" const="true" expression="50"/>
    <Var name="arr_var" type="number[]" size="5"/>
    <Var name="bad_sin" type="number" expression="sin('not_a_number')"/>
    <Var name="bad_substr" type="string" expression="substr(12345, 'two', 5)"/>
    <Var name="mixed_ifelse_type" type="number" expression="ifelse(1, 2.5, 'fallback')"/>
    <Var name="neg_expr" type="number" expression="-#valid_num"/>
    <Var name="high_prec" type="number" expression="0.123456789"/>
    <Var name="no_type_expr" type="string" expression="#valid_num + 10"/>

    <Image name="bg" x="#str_var"
           y="#num_or_str"
           width="1080"
           height="1920"
           alpha="#bad_sin"
           src="bg.png"/>

    <Image name="icon" x="#not_declared" y="#arr_var[7]" width="100" height="100"
           src="icon.png"/>

    <Group name="container" x="-#valid_num" y="0" width="500" height="500">
        <Text name="info" x="250" y="250" size="20" color="#FFFFFF"
              textExp="#bad_substr" category="Normal"/>
    </Group>

    <Image name="valid_img" x="#valid_num" y="#valid_num"
           width="200" height="200" alpha="255" src="valid.png"/>
</Lockscreen>
