{
  "element": "Action",
  "category": "longtake_sub",
  "description": "Action为EventTrigger子标签，通过name和storyBoard属性定义转场动作名称及对应的StoryBoard，实现不同场景间的转场触发。",
  "requiredAttrs": [
    "name", "storyBoard"
  ],
  "optionalAttrs": [
  ],
  "attrTypes": {
    "name": {
      "type": "string",
      "enumValues": [
        "Aod2Lock", "Lock2Home", "Aod2Home", "Lock2Aod", "Home2Aod", "Home2Lock", "Aod", "Lock", "Home"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "元素变量名，在支持表达式的情况中使用@name的格式来取当前变量的值。"
    },
    "storyBoard": {
      "type": "string",
      "enumValues": [
        "OneShotAodLock", "OneShotLockHome", "OneShotAodHome", "OneShotLockAod", "OneShotHomeAod", "OneShotHomeLock",
        "OneShotAod", "OneShotLock", "OneShotHome"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "关联的故事板名称。"
    }
  },
  "allowedParents": [
    "EventTrigger"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": false,
    "Wallpaper": false,
    "LongTake": true,
    "Widget": false,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
  ]
}