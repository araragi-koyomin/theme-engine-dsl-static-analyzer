{
  "element": "Button",
  "category": "control",
  "description": "按钮标签，在锁屏界面有一块显示区域，能够触发Trigger等一系列的操作和命令，可以通过不同的状态标签来展现对应状态下设置的图片或者文字等。",
  "requiredAttrs": [
  ],
  "optionalAttrs": [
    "name", "x", "y", "width", "height", "alpha", "visibility", "category", "align", "alignV", "enableMove", "moveRect",
    "active"
  ],
  "attrTypes": {
    "name": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "按钮的名称"
    },
    "x": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的x坐标，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），默认为0，支持表达式。"
    },
    "y": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的y坐标，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），默认为0，支持表达式。"
    },
    "width": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "w"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "显示在屏幕上的宽，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），支持表达式，w和width写法都可以。"
    },
    "height": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "h"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "显示在屏幕上的高，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），支持表达式，h和height写法都可以。"
    },
    "alpha": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "255",
      "description": "透明度，0-255，默认为255，当值小于0时则该值取0，当值大于255时，该值取255，支持表达式。"
    },
    "visibility": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "元素可见性支持表达式<=0 不可见 >0可见"
    },
    "category": {
      "type": "string",
      "enumValues": [
        "Normal", "Charging", "BatteryLow", "BatteryFull"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "取值\"Normal\", \"Charging\", \"BatteryLow\", \"BatteryFull\"，表示当手机处于指定充电状态时显示该元素。"
    },
    "align": {
      "type": "string",
      "enumValues": [
        "left", "center", "right"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "坐标点水平对齐方式left, center, right，对齐的效果为view的左上角x坐标分别表示该view的左、中、右位置。"
    },
    "alignV": {
      "type": "string",
      "enumValues": [
        "top", "center", "bottom"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "坐标点垂直对齐方式top, center, bottom，对齐的效果为view的左上角y坐标分别表示该view的上、中、下位置。"
    },
    "enableMove": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "false",
      "description": "元素是否支持移动，当值为false或者0时表示不可移动，当值为true或者非0值表示可移动，默认为0。"
    },
    "moveRect": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "移动区域，当enableMove为可移动时有效。格式为moveRect=\"minH,minV,maxH,maxV\"，分别表示：最小水平移动，最小垂直移动，最大水平移动，最大垂直移动。四个参数类型为数值，单位为像素，不支持表达式。例如：移动目标的原坐标为(x,y)，则该目标水平方向的移动范围是：(x+minH)~(x+maxH)，垂直方向的移动范围是：(y+minV)~(y+maxV)。"
    },
    "active": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "1",
      "description": "激活状态，0代表不激活，视图不显示，所有的动画和可见性均失效，默认值1。"
    }
  },
  "allowedParents": [
    "Lockscreen", "Widget", "Group", "LockClock", "StereoGroup"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-TRIG-002",
      "condition": "element.children.filter(c -\u003e c.tagName == \u0027Trigger\u0027).size() == 0 AND element.children.filter(c -\u003e c.tagName == \u0027Triggers\u0027).size() == 0",
      "message": "Button必须包含至少一个Trigger子元素",
      "severity": "error",
      "suggestedFixes": [
        {"text": "添加Trigger子元素", "type": "ADD_CHILD", "target": "Trigger"}
      ]
    }, {
      "ruleId": "SEM-SCOPE-001",
      "condition": "element.scope != \u0027Lockscreen\u0027 AND element.scope != \u0027Widget\u0027",
      "message": "Button仅支持在锁屏(Lockscreen)和百变卡片(Widget)中使用",
      "severity": "error",
      "suggestedFixes": [
        {"text": "将Button移至Lockscreen或Widget中", "type": "MOVE_ELEMENT", "target": "Button", "value": "Lockscreen"}
      ]
    }
  ]
}