{
  "element": "Layer",
  "category": "three_d_sub",
  "description": "图层定义，设置图片的空间位置、尺寸和帧动画等参数。",
  "requiredAttrs": [
    "w", "h", "src"
  ],
  "optionalAttrs": [
    "x", "y", "z", "staticCondition", "delay", "repeat"
  ],
  "attrTypes": {
    "x": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的x坐标，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），默认为0，支持表达式。"
    },
    "y": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的y坐标，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），默认为0，支持表达式。"
    },
    "z": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "图层的空间位置，相机视野内的取值范围为[-10,7]之间的浮点数，支持表达式，默认值为0。屏幕向外为正方向。因使用透视投影，物体显示效果为远小近大。设计图层Layer标签时，需要根据z值从小到大赋值，即图层从远到近的顺序绘制。"
    },
    "w": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "width"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "粒子宽度，取值正实数，最大值为120 px，超过最大值则按120处理，默认值30，支持数值表达式。"
    },
    "h": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "height"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "粒子高度，宽高比例建议1:1，取值正实数，最大值为120 px，超过最大值则按120处理，默认值30，支持数值表达式。"
    },
    "src": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "图片文件名，如：image.gif，也可在前加文件夹，如wenjianjia/image.gif。当图片名称中包含.gif，循环播放Gif图片;图片的大小、位置等参数与Image设置相同，只需要在src参数中填入gif图片名称即可。小于5.0MB动态显示，大于或等于5.0MB静态显示，设计师应提供大小合适图片资源。"
    },
    "staticCondition": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "false",
      "description": "图层是否静态，不随相机位置改变，取值为true和false。为true时表示图层静态，不发送改变。默认为false。"
    },
    "delay": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "动画延迟执行的毫秒数，即触发动画后需要delay毫秒才开始执行动画，取值正整数，默认为0，支持表达式。"
    },
    "repeat": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "动画重复次数，-1表示无限循环，0表示不重复，n表示重复n+1次，默认为0，支持表达式。最小值为-1。"
    }
  },
  "allowedParents": [
    "MultiLayer"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": false,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-3D-LAYER-001",
      "condition": "element.attrs[\u0027z\u0027] != null AND (parseFloat(element.attrs[\u0027z\u0027]) \u003c -10 OR parseFloat(element.attrs[\u0027z\u0027]) \u003e 7)",
      "message": "Layer z值范围应在[-10,7]之间",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "设置z值在-10到7范围内", "type": "CLAMP_VALUE", "target": "z", "range": "-10到7"}
      ]
    }
  ]
}