{
  "element": "MultiLayer",
  "category": "three_d",
  "description": "可以实现多个图层叠加的效果。根据设置的不同z值，展示图层的不同空间位置。与传感器标签<variablebinders>结合使用，左右上下晃动手机时呈现相机角度变换的效果；或者通过左右上下滑动屏幕来改变相机的角度。交互方式可以通过自定义的方式来设计长按或者点击，来实现左右浏览或者调节图层远近。",
  "requiredAttrs": [
  ],
  "optionalAttrs": [
    "gravityX", "gravityY", "touchType", "pitchAngle", "sidesAngle", "stepX", "stepZ", "blur", "visibility"
  ],
  "attrTypes": {
    "gravityX": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "x方向的重力数值。使用表达式，与传感器标签结合使用。应用于模式0和2"
    },
    "gravityY": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "y方向的重力数值。使用表达式，与传感器标签标签结合使用。应用于模式0和2"
    },
    "touchType": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "图层交互模式，数值为0-3，支持表达式，默认值为0。目前共有4种模式：0，重力感应模式；1，上下左右滑动改变相机角度模式；2，重力感应和滑动改变角度模式；3，调节相机远近和左右浏览模式。"
    },
    "pitchAngle": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "俯视和仰视角度的最大值，通过上下滑动切换角度。取值为“top,-up”，top为正数，up为正数，中间以英文逗号隔开。例如：\"8,-8\"。应用于模式1和2"
    },
    "sidesAngle": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "左侧和右侧角度的最大值，通过左右滑动切换角度。取值为“left,-right”，left为正数，right为正数，中间以英文逗号隔开。例如：\"8,-8\"。应用于模式1和2"
    },
    "stepX": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "图层左右浏览的步长，使用表达式计算累加/减，例如：#stepX+0.1。应用于模式3。"
    },
    "stepZ": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "图层靠近远离的步长，使用表达式计算累加/减，例如：#stepZ+0.1。应用于模式3。"
    },
    "blur": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "0",
      "description": "点击图层靠近时，渐变模糊程度，范围是[0,10]，默认为0清晰。"
    },
    "visibility": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "控制可见性，0 不可见 1可见，默认为1。"
    }
  },
  "allowedParents": [
    "Lockscreen"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": false,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-3D-001",
      "condition": "element.attrs[\u0027touchType\u0027] == \u00270\u0027 AND (element.attrs[\u0027pitchAngle\u0027] != null OR element.attrs[\u0027sidesAngle\u0027] != null OR element.attrs[\u0027stepX\u0027] != null OR element.attrs[\u0027stepZ\u0027] != null)",
      "message": "touchType=0(重力感应)模式下pitchAngle/sidesAngle/stepX/stepZ无效",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "移除pitchAngle/sidesAngle/stepX/stepZ属性", "type": "REMOVE_ATTR", "target": "pitchAngle/sidesAngle/stepX/stepZ"},
        {"text": "更改touchType为2(重力+滑动)或3(调距浏览)", "type": "REPLACE_VALUE", "target": "touchType", "value": "2"}
      ]
    }, {
      "ruleId": "SEM-3D-002",
      "condition": "element.attrs[\u0027touchType\u0027] == \u00271\u0027 AND (element.attrs[\u0027gravityX\u0027] != null OR element.attrs[\u0027gravityY\u0027] != null OR element.attrs[\u0027stepX\u0027] != null OR element.attrs[\u0027stepZ\u0027] != null)",
      "message": "touchType=1(滑动角度)模式下gravityX/gravityY/stepX/stepZ无效",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "移除gravityX/gravityY/stepX/stepZ属性", "type": "REMOVE_ATTR", "target": "gravityX/gravityY/stepX/stepZ"},
        {"text": "更改touchType为2(重力+滑动)或0(重力感应)", "type": "REPLACE_VALUE", "target": "touchType", "value": "2"}
      ]
    }, {
      "ruleId": "SEM-3D-003",
      "condition": "element.attrs[\u0027touchType\u0027] == \u00272\u0027 AND (element.attrs[\u0027stepX\u0027] != null OR element.attrs[\u0027stepZ\u0027] != null)",
      "message": "touchType=2(重力+滑动)模式下stepX/stepZ无效",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "移除stepX/stepZ属性", "type": "REMOVE_ATTR", "target": "stepX/stepZ"},
        {"text": "更改touchType为3(调距浏览)", "type": "REPLACE_VALUE", "target": "touchType", "value": "3"}
      ]
    }, {
      "ruleId": "SEM-3D-004",
      "condition": "element.attrs[\u0027touchType\u0027] == \u00273\u0027 AND (element.attrs[\u0027gravityX\u0027] != null OR element.attrs[\u0027gravityY\u0027] != null OR element.attrs[\u0027pitchAngle\u0027] != null OR element.attrs[\u0027sidesAngle\u0027] != null)",
      "message": "touchType=3(调距浏览)模式下gravityX/gravityY/pitchAngle/sidesAngle无效",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "移除gravityX/gravityY/pitchAngle/sidesAngle属性", "type": "REMOVE_ATTR", "target": "gravityX/gravityY/pitchAngle/sidesAngle"},
        {"text": "更改touchType为0(重力感应)、1(滑动角度)或2(重力+滑动)", "type": "REPLACE_VALUE", "target": "touchType", "value": "0"}
      ]
    }
  ]
}