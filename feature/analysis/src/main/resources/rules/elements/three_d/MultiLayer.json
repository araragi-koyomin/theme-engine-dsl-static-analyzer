{
  "element": "MultiLayer",
  "category": "three_d",
  "requiredAttrs": [],
  "optionalAttrs": ["gravityX", "gravityY", "touchType", "pitchAngle", "sidesAngle", "stepX", "stepZ", "blur", "visibility"],
  "attrTypes": {
    "gravityX": {"type": "number", "enumValues": [], "aliases": [], "supportsExpression": true, "expressionKind": "number", "defaultValue": null},
    "gravityY": {"type": "number", "enumValues": [], "aliases": [], "supportsExpression": true, "expressionKind": "number", "defaultValue": null},
    "touchType": {"type": "number", "enumValues": ["0", "1", "2", "3"], "aliases": [], "supportsExpression": true, "expressionKind": "number", "defaultValue": "0"},
    "pitchAngle": {"type": "string", "enumValues": [], "aliases": [], "supportsExpression": false, "expressionKind": null, "defaultValue": null},
    "sidesAngle": {"type": "string", "enumValues": [], "aliases": [], "supportsExpression": false, "expressionKind": null, "defaultValue": null},
    "stepX": {"type": "number", "enumValues": [], "aliases": [], "supportsExpression": true, "expressionKind": "number", "defaultValue": "0"},
    "stepZ": {"type": "number", "enumValues": [], "aliases": [], "supportsExpression": true, "expressionKind": "number", "defaultValue": "0"},
    "blur": {"type": "number", "enumValues": [], "aliases": [], "supportsExpression": false, "expressionKind": null, "defaultValue": "0"},
    "visibility": {"type": "number", "enumValues": [], "aliases": [], "supportsExpression": true, "expressionKind": "number", "defaultValue": "1"}
  },
  "allowedParents": ["Lockscreen"],
  "allowedChildren": ["Layer"],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": false,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-3D-001",
      "condition": "element.attrs['touchType'] == '0' AND (element.attrs['pitchAngle'] != null OR element.attrs['sidesAngle'] != null OR element.attrs['stepX'] != null OR element.attrs['stepZ'] != null)",
      "message": "touchType=0(重力感应)模式下pitchAngle/sidesAngle/stepX/stepZ无效",
      "severity": "warning",
      "suggestedFixes": ["移除pitchAngle/sidesAngle/stepX/stepZ属性", "更改touchType为2(重力+滑动)或3(调距浏览)"]
    },
    {
      "ruleId": "SEM-3D-002",
      "condition": "element.attrs['touchType'] == '1' AND (element.attrs['gravityX'] != null OR element.attrs['gravityY'] != null OR element.attrs['stepX'] != null OR element.attrs['stepZ'] != null)",
      "message": "touchType=1(滑动角度)模式下gravityX/gravityY/stepX/stepZ无效",
      "severity": "warning",
      "suggestedFixes": ["移除gravityX/gravityY/stepX/stepZ属性", "更改touchType为2(重力+滑动)或0(重力感应)"]
    },
    {
      "ruleId": "SEM-3D-003",
      "condition": "element.attrs['touchType'] == '2' AND (element.attrs['stepX'] != null OR element.attrs['stepZ'] != null)",
      "message": "touchType=2(重力+滑动)模式下stepX/stepZ无效",
      "severity": "warning",
      "suggestedFixes": ["移除stepX/stepZ属性", "更改touchType为3(调距浏览)"]
    },
    {
      "ruleId": "SEM-3D-004",
      "condition": "element.attrs['touchType'] == '3' AND (element.attrs['gravityX'] != null OR element.attrs['gravityY'] != null OR element.attrs['pitchAngle'] != null OR element.attrs['sidesAngle'] != null)",
      "message": "touchType=3(调距浏览)模式下gravityX/gravityY/pitchAngle/sidesAngle无效",
      "severity": "warning",
      "suggestedFixes": ["移除gravityX/gravityY/pitchAngle/sidesAngle属性", "更改touchType为0(重力感应)、1(滑动角度)或2(重力+滑动)"]
    }
  ]
}
