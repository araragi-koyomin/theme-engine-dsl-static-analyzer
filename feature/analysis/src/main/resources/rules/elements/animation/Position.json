{
  "element": "Position",
  "category": "animation_frame",
  "description": "位移动画的关键帧，定义某一时刻的位移坐标。",
  "requiredAttrs": [
    "x", "y", "time"
  ],
  "optionalAttrs": [
    "varSpeedFlag"
  ],
  "attrTypes": {
    "x": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "相对于屏幕左上角的x坐标，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），默认为0，支持表达式。"
    },
    "y": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "相对于屏幕左上角的y坐标，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），默认为0，支持表达式。"
    },
    "time": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "表示振动波形的时间间隔，取值范围[0，1800000]，单位为ms，不支持表达式。 考虑到用户友好性，建议取值在1000以内。当前slice的time要大于等于上个slice的time+duration的值且time的值必须唯一。"
    },
    "varSpeedFlag": {
      "type": "string",
      "enumValues": [
        "SineFun_In", "SineFun_Out", "SineFun_InOut", "QuadFun_In", "QuadFun_Out", "QuadFun_InOut", "CubicFun_In",
        "CubicFun_Out", "CubicFun_InOut", "QuartFun_In", "QuartFun_Out", "QuartFun_InOut", "QuintFun_In",
        "QuintFun_Out", "QuintFun_InOut", "ExpoFun_In", "ExpoFun_Out", "ExpoFun_InOut", "CircFun_In", "CircFun_Out",
        "CircFun_InOut", "BackFun_In", "BackFun_Out", "BackFun_InOut", "ElasticFun_In", "ElasticFun_Out",
        "ElasticFun_InOut", "BounceFun_In", "BounceFun_Out", "BounceFun_InOut"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "变速函数属性，设置后作用于该帧及下一帧，支持30种函数类型，控制动画按照非线性变化。"
    }
  },
  "allowedParents": [
    "PositionAnimation"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
  ]
}