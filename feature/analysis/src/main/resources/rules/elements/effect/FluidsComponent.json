{
  "element": "FluidsComponent",
  "category": "effect",
  "description": "模拟流体流动效果，可以设置流体的颜色，数量以及区域等，可以应用在锁屏和桌面上。",
  "requiredAttrs": [
  ],
  "optionalAttrs": [
    "gravityRatio", "viscosity", "color", "waterAlpha", "waterAlphaThreshold", "bgSrc", "scaleType", "srcid", "persist"
  ],
  "attrTypes": {
    "gravityRatio": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "设置流体的重力系数，取值范围为（0-1），默认为1"
    },
    "viscosity": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "设置流体的粘滞系数，取值范围为（0-1）；有值且正确时，粒子为粘性粒子，否则为水粒子；默认为水粒子。"
    },
    "color": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "string",
      "defaultValue": null,
      "description": "设置流体的颜色"
    },
    "waterAlpha": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "设置流体的透明度，取值范围为（0-1），默认为1"
    },
    "waterAlphaThreshold": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0.7",
      "description": "设置流体混和的透明度阈值，取值范围为（0-1），默认值为0.7"
    },
    "bgSrc": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "设置流体的背景"
    },
    "scaleType": {
      "type": "string",
      "enumValues": [
        "fill", "center_crop"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "center_crop",
      "description": "背景图片的缩放模式，目前支持两种模式，默认为center_crop。 fill表示填充满屏幕，若图片比例与屏幕不匹配会导致图片拉伸；center_crop表示按照宽或高的比例进行适配，使图片充满整个屏幕，多余部分裁剪"
    },
    "srcid": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "图片序列后缀数字，一般用变量表示，可以根据变量显示不同的图片，如果src=\"pic.png\" srcid=\"1\" 则最后会显示图片 \"pic_1.png\"，大于0， 正整数，支持数字表达式。"
    },
    "persist": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "变量持久化，默认为false不进行持久化，如果需要保存则在声明变量的时候显式设置persist=\"true\"。开启变量持久化之后，会优先读取本地同名变量是否有值，如果没有则赋予expression或者默认值，如果有值则会忽略设置的expression值。"
    }
  },
  "allowedParents": [
    "Lockscreen", "Wallpaper", "ChargingSkin"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": false,
    "Widget": false,
    "ChargingSkin": true
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
  ]
}