{
  "element": "MediaController",
  "category": "data_open",
  "description": "音乐控制器，在使用音乐数据和播控功能时需要先声明MediaController，用于指定音乐App包名。",
  "requiredAttrs": [
  ],
  "optionalAttrs": [
    "packageName"
  ],
  "attrTypes": {
    "packageName": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "com.huawei.hmsapp.music",
      "description": "指定音乐App的包名，当前仅支持指定华为音乐App（com.huawei.hmsapp.music）"
    }
  },
  "allowedParents": [
    "Lockscreen", "Wallpaper", "Widget", "Group", "LongTake"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-MEDIA-001",
      "condition": "using MediaCommand or MediaIcon without MediaController declared",
      "message": "使用MediaCommand或MediaIcon前必须声明MediaController",
      "severity": "error",
      "suggestedFixes": [
        {"text": "添加\u003cMediaController/\u003e声明", "type": "ADD_DECLARATION", "target": "MediaController"}
      ]
    }
  ]
}