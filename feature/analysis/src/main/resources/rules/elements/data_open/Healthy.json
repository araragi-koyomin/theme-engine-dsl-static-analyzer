{
  "element": "Healthy",
  "category": "data_open",
  "description": "开放运动健康App的步数、距离、卡路里、实时心率和静息心率数据，设计师可基于这些数据制作创意主题。",
  "requiredAttrs": [
  ],
  "optionalAttrs": [
    "polling", "time"
  ],
  "attrTypes": {
    "polling": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "false",
      "description": "轮询开关，true为开启轮询，false为关闭轮询。默认是false。"
    },
    "time": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "5",
      "description": "轮询时间间隔，单位（秒），最小值为1，仅在polling为true的时候有效。默认是5秒。"
    }
  },
  "allowedParents": [
    "Lockscreen", "Wallpaper", "Widget", "Group", "LongTake"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-HEALTHY-001",
      "condition": "element.attrs[\u0027time\u0027] != null AND element.attrs[\u0027time\u0027] \u003c 1",
      "message": "time属性最小值为1(秒)",
      "severity": "error",
      "suggestedFixes": [
        {"text": "设置time属性值\u003e=1", "type": "SET_VALUE", "target": "time", "value": "1"}
      ]
    }, {
      "ruleId": "SEM-HEALTHY-002",
      "condition": "element.attrs[\u0027time\u0027] != null AND element.attrs[\u0027polling\u0027] != \u0027true\u0027",
      "message": "time属性仅在polling=true时有效",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "设置polling=\u0027true\u0027", "type": "SET_VALUE", "target": "polling", "value": "true"}
      ]
    }
  ]
}