{
  "element": "MediaCommand",
  "category": "data_open",
  "description": "音乐控制命令，用于执行播放、暂停、收藏、切歌、音量调节及播放模式切换等操作，使用前需先声明MediaController。",
  "requiredAttrs": [
    "command"
  ],
  "optionalAttrs": [
    "voiceStep100", "condition"
  ],
  "attrTypes": {
    "command": {
      "type": "string",
      "enumValues": [
        "mediaPlay", "mediaPause", "mediaLike", "mediaDislike", "skipToPrevious", "skipToNext", "addVoice", "subVoice",
        "mediaRepeatMode"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "command可以设置的值如下：mediaPlay：音乐播放命令mediaPause：音乐暂停命令mediaLike：音乐收藏命令（仅华为音乐支持）mediaDislike：音乐取消收藏命令（仅华为音乐支持）skipToPrevious：上一首skipToNext：下一首addVoice：增加音量subVoice：减少音量mediaRepeatMode：修改播放模式说明mediaLike和mediaDislike仅华为音乐支持。"
    },
    "voiceStep100": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "10",
      "description": "音量变化的步进值，默认为10，支持表达式。"
    },
    "condition": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "条件判断，支持表达式。当condition里的条件判断为非0或者为true时，该命令执行，为false或者0则不执行。支持输入表达式"
    }
  },
  "allowedParents": [
    "Trigger"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-MEDIA-001",
      "condition": "no MediaController declared in document",
      "message": "使用MediaCommand前必须声明MediaController",
      "severity": "error",
      "suggestedFixes": [
        {"text": "添加\u003cMediaController/\u003e声明", "type": "ADD_DECLARATION", "target": "MediaController"}
      ]
    }, {
      "ruleId": "SEM-MEDIA-002",
      "condition": "element.attrs[\u0027command\u0027] IN [\u0027mediaLike\u0027,\u0027mediaDislike\u0027] AND no MediaController with packageName=\u0027com.huawei.hmsapp.music\u0027",
      "message": "mediaLike和mediaDislike仅华为音乐(com.huawei.hmsapp.music)支持",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "确认MediaController指定华为音乐包名", "type": "CONFIRM", "target": "MediaController"}
      ]
    }
  ]
}