{
  "element": "MediaCommand",
  "category": "data_open",
  "requiredAttrs": [
    "command"
  ],
  "optionalAttrs": [
    "voiceStep100", "condition"
  ],
  "attrTypes": {
    "command": {
      "type": "string",
      "enumValues": [
        "mediaPlay", "mediaPause", "mediaLike", "mediaDislike", "skipToPrevious", "skipToNext", "addVoice", "subVoice",
        "mediaRepeatMode"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null
    },
    "voiceStep100": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "10"
    },
    "condition": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null
    }
  },
  "allowedParents": [
    "Trigger"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-MEDIA-001",
      "condition": "no MediaController declared in document",
      "message": "使用MediaCommand前必须声明MediaController",
      "severity": "error",
      "suggestedFixes": [
        {"text": "添加\u003cMediaController/\u003e声明", "type": "ADD_DECLARATION", "target": "MediaController"}
      ]
    }, {
      "ruleId": "SEM-MEDIA-002",
      "condition": "element.attrs[\u0027command\u0027] IN [\u0027mediaLike\u0027,\u0027mediaDislike\u0027] AND no MediaController with packageName=\u0027com.huawei.hmsapp.music\u0027",
      "message": "mediaLike和mediaDislike仅华为音乐(com.huawei.hmsapp.music)支持",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "确认MediaController指定华为音乐包名", "type": "CONFIRM", "target": "MediaController"}
      ]
    }
  ]
}