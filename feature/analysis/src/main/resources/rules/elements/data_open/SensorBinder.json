{
  "element": "SensorBinder",
  "category": "data_open",
  "description": "支持获取四种类型的传感器数据：加速传感器（accelerometer）、重力传感器（gravity）、线性加速传感器（linearAccelerometer）和陀螺仪（gyroscope）。加速传感器获取的值为线性加速度与重力加速度之和。基于传感器功能可实现重力感应和摇一摇等效果。",
  "requiredAttrs": [
    "type"
  ],
  "optionalAttrs": [
    "vibrate", "shakeTime", "delay"
  ],
  "attrTypes": {
    "type": {
      "type": "string",
      "enumValues": [
        "accelerometer", "gravity", "linearAccelerometer", "gyroscope"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "支持：accelerometer,gravity,linearAccelerometer,gyroscope四种类型"
    },
    "vibrate": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "摇一摇是否触发震动，取值0/1。0表示不触发震动，1表示触发震动。默认为0，支持表达式"
    },
    "shakeTime": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "摇一摇触发震动的震动时长，单位为ms，默认为0，支持表达式"
    },
    "delay": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "摇一摇触发震动的延时时间，单位为ms，默认为0，支持表达式"
    }
  },
  "allowedParents": [
    "VariableBinders"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": true
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-SENSOR-001",
      "condition": "child Variable missing \u0027name\u0027 or \u0027index\u0027 attribute",
      "message": "SensorBinder的子Variable必须同时设置name和index属性",
      "severity": "error",
      "suggestedFixes": [
        {"text": "为Variable添加name和index属性", "type": "ADD_ATTR", "target": "name和index"}
      ]
    }, {
      "ruleId": "SEM-SENSOR-002",
      "condition": "child Variable.attrs[\u0027index\u0027] NOT IN [0,1,2]",
      "message": "Variable的index属性取值必须为0、1或2",
      "severity": "error",
      "suggestedFixes": [
        {"text": "设置index为0/1/2", "type": "SET_VALUE", "target": "index", "value": "0/1/2"}
      ]
    }
  ]
}