{
  "element": "ImageSeries",
  "category": "view",
  "description": "串联图片ImageSeries提供了根据输入字符串进行图片串联的功能，即能够按照字符顺序将字符图片拼在一起并显示；相比较ImageNumber，串联图片能够解析字符而不仅限于数字，提供了更强的解析能力。例如，可以用字符图片显示 '2020.01.01'（包含两个'.'）或者 'Moon Festival 8.15'(包含字符)，而这些功能数字图片均无法支持。",
  "requiredAttrs": [
    "src", "string", "mapList"
  ],
  "optionalAttrs": [
    "name", "x", "y", "pivotX", "pivotY", "rotation", "alpha", "visibility", "align", "alignV", "enableMove",
    "moveRect", "active", "category", "space"
  ],
  "attrTypes": {
    "name": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "元素变量名，在支持表达式的情况中使用@name的格式来取当前变量的值。"
    },
    "x": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的x坐标，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），默认为0，支持表达式。"
    },
    "y": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的y坐标，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），默认为0，支持表达式。"
    },
    "pivotX": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "centerX"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "旋转的点的X坐标，相对于View的左上角位置，单位为像素，支持表达式，pivotX和centerX写法都可以。"
    },
    "pivotY": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "centerY"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "旋转的点的Y坐标，相对于View的左上角位置，单位为像素，支持表达式，pivotY和centerY写法都可以。"
    },
    "rotation": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "angle"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "旋转角度，一周360度，围绕(pivotX,pivotY)点旋转（若无pivotX和pivotY，则默认(0,0)点旋转），支持表达式。正数表示顺时针，负数表示逆时针，rotation和angle写法都可以。"
    },
    "alpha": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "255",
      "description": "透明度，0-255，默认为255，当值小于0时则该值取0，当值大于255时，该值取255，支持表达式。"
    },
    "visibility": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "元素可见性，<=0 不可见 >0可见，true为可见，false为不可见，默认为1，支持表达式。"
    },
    "align": {
      "type": "string",
      "enumValues": [
        "left", "center", "right"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "坐标点水平对齐方式left, center, right，对齐的效果为view的左上角x坐标分别表示该view的左、中、右位置。"
    },
    "alignV": {
      "type": "string",
      "enumValues": [
        "top", "center", "bottom"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "坐标点垂直对齐方式top, center, bottom，对齐的效果为view的左上角y坐标分别表示该view的上、中、下位置。"
    },
    "enableMove": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "false",
      "description": "元素是否支持移动，当值为false或者0时表示不可移动，当值为true或者非0值表示可移动，默认为0。"
    },
    "moveRect": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "移动区域，当enableMove为可移动时有效。格式为moveRect=\"minH,minV,maxH,maxV\"，分别表示：最小水平移动，最小垂直移动，最大水平移动，最大垂直移动。四个参数类型为数值，单位为像素，不支持表达式。例如：移动目标的原坐标为(x,y)，则该目标水平方向的移动范围是：(x+minH)~(x+maxH)，垂直方向的移动范围是：(y+minV)~(y+maxV)。"
    },
    "active": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "1",
      "description": "激活状态，0代表不激活，视图不显示，所有的动画和可见性均失效，默认值1。"
    },
    "category": {
      "type": "string",
      "enumValues": [
        "Normal", "Charging", "BatteryLow", "BatteryFull"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "取值\"Normal\", \"Charging\", \"BatteryLow\", \"BatteryFull\"，表示当手机处于指定充电状态时显示该元素。"
    },
    "src": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "待拼接的字符图片前缀，前缀与后缀通过“_”连接"
    },
    "string": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "string",
      "defaultValue": null,
      "description": "按照字符串的形式提供待拼接的多张字符图片后缀，支持字符串和字符串表达式。例如，letter_0.png表示一张完整字符图片名称，其中letter表示前缀，0表示后缀，通过“_”相连"
    },
    "space": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "0",
      "description": "待拼接的字符图片之间的间隔，默认为0"
    },
    "mapList": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "映射列表，用英文逗号分隔。其中，每项第一个字符表示原字符（对应string中的字符），后续字符串（一个或多个）表示映射字符串（对应字符图片名称）"
    }
  },
  "allowedParents": [
    "Lockscreen", "Wallpaper", "Widget", "ChargingSkin", "Group", "LongTake"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": true,
    "Widget": true,
    "ChargingSkin": true
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
  ]
}