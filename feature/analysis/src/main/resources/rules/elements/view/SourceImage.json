  "constraints": [
    {
      "ruleId": "SEM-SRCIMG-001",
      "condition": "element.attrs[\u0027direction\u0027] == \u00270\u0027 AND (element.attrs[\u0027loop\u0027] != \u0027true\u0027 OR element.attrs[\u0027unlockTo\u0027] == null)",
