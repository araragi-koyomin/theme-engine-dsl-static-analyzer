{
  "element": "SourceImage",
  "category": "view",
  "description": "根据设定的图片和时间间隔顺序播放图片，是另外一种形式的帧动画。它提供解锁的功能，当触摸时帧数大于等于设定值时能够调用解锁操作，若未大于等于设定值时抬起手指，则加速递减回首帧。但是，帧解锁视图会在一定程度上牺牲流畅度，降低系统的内存占用，适用于不需要高流畅度的帧动画效果。",
  "requiredAttrs": [
    "sourceName", "format", "to"
  ],
  "optionalAttrs": [
    "name", "x", "y", "width", "height", "pivotX", "pivotY", "rotation", "rotationX", "rotationY", "alpha",
    "visibility", "align", "alignV", "enableMove", "moveRect", "active", "from", "space", "loop", "direction",
    "unlockTo"
  ],
  "attrTypes": {
    "name": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "元素变量名，在支持表达式的情况中使用@name的格式来取当前变量的值。"
    },
    "x": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的x坐标，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），默认为0，支持表达式。"
    },
    "y": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "相对于屏幕左上角的y坐标，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），默认为0，支持表达式。"
    },
    "width": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "w"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "显示在屏幕上的宽，单位为像素，显示范围为屏幕的宽（1920*1080的屏幕，显示的宽的范围为0~1080），支持表达式，w和width写法都可以。"
    },
    "height": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "h"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "显示在屏幕上的高，单位为像素，显示范围为屏幕的高（1920*1080的屏幕，显示的高的范围为0~1920），支持表达式，h和height写法都可以。"
    },
    "pivotX": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "centerX"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "旋转的点的X坐标，相对于View的左上角位置，单位为像素，支持表达式，pivotX和centerX写法都可以。"
    },
    "pivotY": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "centerY"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "旋转的点的Y坐标，相对于View的左上角位置，单位为像素，支持表达式，pivotY和centerY写法都可以。"
    },
    "rotation": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "angle"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "旋转角度，一周360度，围绕(pivotX,pivotY)点旋转（若无pivotX和pivotY，则默认(0,0)点旋转），支持表达式。正数表示顺时针，负数表示逆时针，rotation和angle写法都可以。"
    },
    "rotationX": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "angleX"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "以X轴为旋转中心旋转，一周360度，支持表达式。正数表示顺时针，负数表示逆时针，rotationX和angleX写法都可以。"
    },
    "rotationY": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
        "angleY"
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "以Y轴为旋转中心旋转，一周360度，支持表达式。正数表示顺时针，负数表示逆时针，rotationY和angleY写法都可以。"
    },
    "alpha": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "255",
      "description": "透明度，0-255，默认为255，当值小于0时则该值取0，当值大于255时，该值取255，支持表达式。"
    },
    "visibility": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "元素可见性，<=0 不可见 >0可见，true为可见，false为不可见，默认为1，支持表达式。"
    },
    "align": {
      "type": "string",
      "enumValues": [
        "left", "center", "right"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "坐标点水平对齐方式left, center, right，对齐的效果为view的左上角x坐标分别表示该view的左、中、右位置。"
    },
    "alignV": {
      "type": "string",
      "enumValues": [
        "top", "center", "bottom"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "坐标点垂直对齐方式top, center, bottom，对齐的效果为view的左上角y坐标分别表示该view的上、中、下位置。"
    },
    "enableMove": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "false",
      "description": "元素是否支持移动，当值为false或者0时表示不可移动，当值为true或者非0值表示可移动，默认为0。"
    },
    "moveRect": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "移动区域，当enableMove为可移动时有效。格式为moveRect=\"minH,minV,maxH,maxV\"，分别表示：最小水平移动，最小垂直移动，最大水平移动，最大垂直移动。四个参数类型为数值，单位为像素，不支持表达式。例如：移动目标的原坐标为(x,y)，则该目标水平方向的移动范围是：(x+minH)~(x+maxH)，垂直方向的移动范围是：(y+minV)~(y+maxV)。"
    },
    "active": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "1",
      "description": "激活状态，0代表不激活，视图不显示，所有的动画和可见性均失效，默认值1。"
    },
    "sourceName": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "指定图片名的前缀，例如name=\"aa/pic__\"，表示aa文件夹中pic_开头的图片"
    },
    "format": {
      "type": "string",
      "enumValues": [
        "jpg", "png"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "图片后缀名，.jpg/.png，组合成的图片的文件名，例如 aa/pic_0.jpg"
    },
    "from": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "动画首帧图片名字的序号，正整数，默认0，支持表达式"
    },
    "to": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "0",
      "description": "动画末帧图片名字的序号，正整数，默认0，支持表达式"
    },
    "space": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "30",
      "description": "每帧动画播放的间隔时间（毫秒），正整数，默认30"
    },
    "loop": {
      "type": "string",
      "enumValues": [
        "true", "false"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "true",
      "description": "动画是否需要循环，true/false，默认为true。true时循环播放，可与direction和unlockTo配合设置触发解锁。false时只播放一次，direction无效，即不能触发解锁，unlockTo参数依旧有效，在小于unlockTo时点击屏幕加速递减回到首帧并停止，若长按至unlockTo则停止在unlockTo；若大于等于unlockTo时点击屏幕则停止在当前帧；若不点击则在to帧时停止。"
    },
    "direction": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "1",
      "description": "取值0/1，如果需要使用帧动画解锁，direction设置为0，loop必须为true，unlockTo必须有值。如果不需要解锁，设置direction为1，loop为true时，会正常从首帧到末帧循环播放。direction默认值1"
    },
    "unlockTo": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "触发解锁的帧序号，(from,to)间正整数，如果需要使用帧动画解锁，必须设置触发解锁的帧序号。触摸屏幕后，当当前图片序号大于等于这一帧序号-1时解锁。如果unlock直接设置为末帧或者超过末帧，序号会直接增大到末帧并解锁。注意解锁功能需要与一个button区域结合使用，即需要一个button区域才能够触发。"
    }
  },
  "allowedParents": [
    "Lockscreen"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": false,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-SRCIMG-001",
      "condition": "element.attrs[\u0027direction\u0027] == \u00270\u0027 AND (element.attrs[\u0027loop\u0027] != \u0027true\u0027 OR element.attrs[\u0027unlockTo\u0027] == null)",
      "message": "direction=0(帧动画解锁)时loop必须为true且unlockTo必须有值",
      "severity": "error",
      "suggestedFixes": [
        {"text": "设置loop=true", "type": "SET_VALUE", "target": "loop", "value": "true"},
        {"text": "设置unlockTo属性值", "type": "SET_VALUE", "target": "unlockTo"},
        {"text": "将direction改为1", "type": "REPLACE_VALUE", "target": "direction", "value": "1"}
      ]
    }, {
      "ruleId": "SEM-SRCIMG-002",
      "condition": "element.attrs[\u0027unlockTo\u0027] != null AND element.parent.children.filter(c -\u003e c.tagName == \u0027Button\u0027).size() == 0",
      "message": "unlockTo设置解锁帧数，但同级无Button元素作为触控区域，解锁功能可能无法触达",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "添加Button元素作为触控区域", "type": "ADD_CHILD", "target": "Button"},
        {"text": "移除unlockTo属性", "type": "REMOVE_ATTR", "target": "unlockTo"}
      ]
    }
  ]
}