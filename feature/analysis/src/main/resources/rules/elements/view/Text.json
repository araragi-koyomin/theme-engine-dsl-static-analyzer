      "ruleId": "SEM-ATTR-006",
      "condition": "element.attrs[\u0027color\u0027] != null AND element.attrs[\u0027autoLineFeed\u0027] == \u0027true\u0027 AND element.attrs[\u0027width\u0027] == null",
