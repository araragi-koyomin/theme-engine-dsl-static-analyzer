  "constraints": [
    {
      "ruleId": "SEM-ATTR-005",
      "condition": "element.attrs[\u0027isBackground\u0027] == \u0027true\u0027 AND element.attrs[\u0027scaleType\u0027] != null AND element.attrs[\u0027scaleType\u0027] != \u0027center_crop\u0027",
      "message": "isBackground=true时必须配合scaleType=center_crop",
      "severity": "error",
      "suggestedFixes": [
        {"text": "设置scaleType=center_crop", "type": "SET_VALUE", "target": "scaleType", "value": "center_crop"}
      ]
    }, {
      "ruleId": "SEM-IMG-002",
      "condition": "element.attrs[\u0027src\u0027] != null AND element.attrs[\u0027srcExp\u0027] != null",
      "message": "src与srcExp无法共存，当存在src值时图片使用src作为地址",
      "severity": "error",
      "suggestedFixes": [
        {"text": "移除srcExp属性", "type": "REMOVE_ATTR", "target": "srcExp"},
        {"text": "移除src属性", "type": "REMOVE_ATTR", "target": "src"}
      ]
    }, {
      "ruleId": "SEM-IMG-003",
      "condition": "element.attrs[\u0027isBackground\u0027] == \u0027true\u0027 AND element.attrs[\u0027align\u0027] != null",
      "message": "isBackground与align同时使用时isBackground不生效",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "移除align属性", "type": "REMOVE_ATTR", "target": "align"},
        {"text": "移除isBackground属性", "type": "REMOVE_ATTR", "target": "isBackground"}
      ]
    }, {
      "ruleId": "SEM-ATTR-001",
      "condition": "element.attrs[\u0027alpha\u0027] != null AND (element.attrs[\u0027alpha\u0027] \u003c 0 OR element.attrs[\u0027alpha\u0027] \u003e 255)",
      "message": "alpha值应在0-255范围内",
      "severity": "error",
      "suggestedFixes": [
        {"text": "设置alpha值在0-255范围内", "type": "CLAMP_VALUE", "target": "alpha", "range": "0-255"}
      ]
    }, {
      "ruleId": "SEM-IMG-SRC",
      "condition": "element.attrs[\u0027src\u0027] == null AND element.attrs[\u0027srcExp\u0027] == null",
      "message": "Image的src与srcExp至少需要填写一个以指定显示图片",
      "severity": "error",
      "suggestedFixes": [
        {"text": "添加src属性指定图片路径", "type": "ADD_ATTR", "target": "src"},
        {"text": "添加srcExp属性指定图片源表达式", "type": "ADD_ATTR", "target": "srcExp"}
      ]
    }
  ]
