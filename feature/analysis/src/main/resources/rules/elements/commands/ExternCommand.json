{
  "element": "ExternCommand",
  "category": "command",
  "description": "通用命令ExternCommand，用来向外部程序发送命令。目前仅能够支持解锁命令(仅在锁屏中有效)用这个命令可以实现解锁操作；ExternalCommand，与ExternCommand相对，是用来接收外部命令的命令，ExternalCommand是一种特殊的Command，不集成在Trigger标签之下而是直接写在Lockscreen标签之下，作为监测开关屏的命令。",
  "requiredAttrs": [
    "command"
  ],
  "optionalAttrs": [
    "condition", "delay", "delayCondition"
  ],
  "attrTypes": {
    "command": {
      "type": "string",
      "enumValues": [
        "unlock"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "命令名，目前可以使用的一种命令是解锁命令unlock(仅在锁屏中有效)"
    },
    "condition": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "条件判断该Command是否执行，支持表达式。仅当值为非0或者为true时，该命令执行。为false或者0则不执行。"
    },
    "delay": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "延迟，单位ms。延迟delay毫秒后执行该命令。"
    },
    "delayCondition": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "延迟判断，为真则delay命令生效，否则失效。默认为true或者1时，表示可以延迟启动命令，如果false或者非1则不延迟执行。"
    }
  },
  "allowedParents": [
    "Trigger"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": false,
    "ChargingSkin": true
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-EXTERN-001",
      "condition": "element.attrs[\u0027delay\u0027] != null AND element.attrs[\u0027delay\u0027] \u003e 3000",
      "message": "延迟解锁最大时间不超过3000ms",
      "severity": "error",
      "suggestedFixes": [
        {"text": "设置delay值不超过3000", "type": "CLAMP_VALUE", "target": "delay", "value": "3000"}
      ]
    }
  ]
}