{
  "element": "IntentCommand",
  "category": "command",
  "description": "通过IntentCommand命令，可以跳转打开其他应用程序App，一次只能跳转一个应用，不能实现连续跳转多个应用。",
  "requiredAttrs": [
    "package", "class"
  ],
  "optionalAttrs": [
    "action", "category", "condition", "delay", "delayCondition", "uri", "type"
  ],
  "attrTypes": {
    "package": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "intent需要设置的的包名（参考应用示例）"
    },
    "class": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "intent需要设置的类名（参考应用示例）"
    },
    "action": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "intent的action（使用package和class时忽略该参数。参考应用示例）"
    },
    "category": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "intent需要设置的category（参考应用示例）"
    },
    "condition": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "条件判断，支持表达式。当condition里的条件判断为非0或者为true时，该命令执行，为false或者0则不执行。"
    },
    "delay": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "延迟，以毫秒记。延迟delay毫秒后执行该命令。"
    },
    "delayCondition": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "延迟判断，为真则delay命令生效，否则失效。默认为true或者1时，表示可以延迟启动命令，如果false或者非1则不延迟执行。"
    },
    "uri": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
