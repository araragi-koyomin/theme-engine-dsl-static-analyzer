{
  "element": "CollaborationCommands",
  "category": "command",
  "description": "通过碰一碰协同框架能力，支持主题在碰一碰场景定义一些动画交互能力。",
  "requiredAttrs": [
    "collaborationId"
  ],
  "optionalAttrs": [
    "abilityId", "enable"
  ],
  "attrTypes": {
    "collaborationId": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "两个主题可以支持碰一碰协同效果的协同ID，不同协同ID的两个设备主题碰一碰不会触发协同效果，协同ID由ThemeStudio Pro工具自动生成，长度为4的字符串，内容为A-Z或a-z或0-9"
    },
    "abilityId": {
      "type": "number",
      "enumValues": [
        "0", "1"
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "0",
      "description": "不配置时，默认为碰一碰 0：碰一碰 1：长连接 起始规范版本：HarmonyOS 7.0"
    },
    "enable": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": "1",
      "description": "支持数值表达式控制协同能力是否打开，0：关闭，1：打开。默认为1(例外：针对百变卡片，跨设备互动能力默认为关闭，需要通过设置全局变量enableCollaboration开启能力)"
    }
  },
  "allowedParents": [
    "Lockscreen", "Widget"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": false,
    "LongTake": false,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": false
  },
  "constraints": [
    {
      "ruleId": "SEM-COLLAB-001",
      "condition": "element.attrs[\u0027collaborationId\u0027] != null AND NOT matchesPattern(element.attrs[\u0027collaborationId\u0027], \u0027^[A-Za-z0-9]{4}$\u0027)",
      "message": "collaborationId必须是长度为4的字符串，内容为A-Z、a-z或0-9",
      "severity": "error",
      "suggestedFixes": [
        {"text": "修改collaborationId为4位A-Z/a-z/0-9字符串", "type": "MODIFY_NAME_FORMAT", "target": "collaborationId", "value": "4位A-Z/a-z/0-9"}
      ]
    }, {
      "ruleId": "SEM-COLLAB-002",
      "condition": "countElementsByType(\u0027CollaborationCommands\u0027) \u003e 1",
      "message": "一个脚本中只能有一个CollaborationCommands节点",
      "severity": "error",
      "suggestedFixes": [
        {"text": "删除多余的CollaborationCommands节点", "type": "DELETE_NODE", "target": "CollaborationCommands"}
      ]
    }
  ]
}