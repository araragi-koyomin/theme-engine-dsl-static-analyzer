{
  "element": "StyleCommand",
  "category": "command",
  "description": "使用StyleCommand命令可以实现同一主题不同aod、skin样式的切换。触发方式包括但不限于：通过数据变化驱动（比如天气数据、步数数据、音量数据等）、通过单击/滑动/双击等驱动变化、通过时间范围驱动变化。",
  "requiredAttrs": [
    "index"
  ],
  "optionalAttrs": [
    "name", "contentTypes", "condition"
  ],
  "attrTypes": {
    "index": {
      "type": "number",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "对应style文件路径的索 0:代表默认，1：style1， 2： style2， x: style*x* （不支持表达式）"
    },
    "name": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": null,
      "description": "元素变量名，在支持表达式的情况中使用@name的格式来取当前变量的值。"
    },
    "contentTypes": {
      "type": "string",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": false,
      "expressionKind": null,
      "defaultValue": "aod|skin",
      "description": "需要刷新的模块。模块包括：aod、skin，写法为：模块名\\"
    },
    "condition": {
      "type": "expression",
      "enumValues": [
      ],
      "aliases": [
      ],
      "supportsExpression": true,
      "expressionKind": "number",
      "defaultValue": null,
      "description": "条件判断，支持表达式。当condition里的条件判断为非0或者为true时，该命令执行，为false或者0则不执行。支持输入表达式"
    }
  },
  "allowedParents": [
    "Trigger"
  ],
  "inherits": null,
  "scope": {
    "Lockscreen": true,
    "Wallpaper": true,
    "LongTake": false,
    "Widget": true,
    "ChargingSkin": false
  },
  "deviceSupport": {
    "barPhone": true,
    "foldable": true,
    "tablet": true
  },
  "constraints": [
    {
      "ruleId": "SEM-CMD-004",
      "condition": "element.attrs[\u0027index\u0027] != null AND containsExpression(element.attrs[\u0027index\u0027])",
      "message": "StyleCommand的index属性不支持表达式",
      "severity": "error",
      "suggestedFixes": [
        {"text": "将index改为纯数字值", "type": "REPLACE_VALUE", "target": "index", "value": "纯数字"}
      ]
    }, {
      "ruleId": "SEM-CMD-003",
      "condition": "element.parentTrigger != null AND element.parentTrigger.parentElement.attrs[\u0027styleGlobalPersist\u0027] != \u0027true\u0027",
      "message": "StyleCommand搭配的变量需要设置styleGlobalPersist为true",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "为相关变量添加styleGlobalPersist=\u0027true\u0027属性", "type": "ADD_ATTR", "target": "styleGlobalPersist"}
      ]
    }, {
      "ruleId": "SEM-PERSIST-003",
      "condition": "element.attrs[\u0027styleGlobalPersist\u0027] != null AND element.attrs[\u0027styleGlobalPersist\u0027] != \u0027true\u0027",
      "message": "styleGlobalPersist变量初始值默认为0，expression初始赋值会被忽略",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "设置styleGlobalPersist=\u0027true\u0027", "type": "SET_VALUE", "target": "styleGlobalPersist", "value": "true"}
      ]
    }
  ]
}