  "constraints": [
    {
      "ruleId": "SEM-CMD-004",
      "condition": "element.attrs[\u0027index\u0027] != null AND containsExpression(element.attrs[\u0027index\u0027])",
      "message": "StyleCommand的index属性不支持表达式",
      "severity": "error",
      "suggestedFixes": [
        {"text": "将index改为纯数字值", "type": "REPLACE_VALUE", "target": "index", "value": "纯数字"}
      ]
    }, {
      "ruleId": "SEM-CMD-003",
      "condition": "element.parentTrigger != null AND element.parentTrigger.parentElement.attrs[\u0027styleGlobalPersist\u0027] != \u0027true\u0027",
      "message": "StyleCommand搭配的变量需要设置styleGlobalPersist为true",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "为相关变量添加styleGlobalPersist=\u0027true\u0027属性", "type": "ADD_ATTR", "target": "styleGlobalPersist"}
      ]
    }, {
      "ruleId": "SEM-PERSIST-003",
      "condition": "element.attrs[\u0027styleGlobalPersist\u0027] != \u0027true\u0027",
      "message": "styleGlobalPersist变量初始值默认为0，expression初始赋值会被忽略",
      "severity": "warning",
      "suggestedFixes": [
        {"text": "设置styleGlobalPersist=\u0027true\u0027", "type": "SET_VALUE", "target": "styleGlobalPersist", "value": "true"}
      ]
    }
  ]
