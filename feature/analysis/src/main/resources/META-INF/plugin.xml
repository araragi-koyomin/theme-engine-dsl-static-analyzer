<idea-plugin>
    <id>com.huawei.theme.analysis</id>
    <name>ThemeDevStudio Analysis</name>
    <vendor email="support@huawei.com" url="https://www.huawei.com">Huawei</vendor>

    <description><![CDATA[
    DSL static analysis tool for Huawei Theme Engine.<br>
    Provides syntax and semantic inspection, quick fix, and batch checking capabilities.
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.huawei.theme.analysis.plugin.rule.RuleRepositoryService"/>

        <fileType name="ThemeDSL"
                  implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslFileType"
                  fieldName="INSTANCE"
                  language="ThemeDSL"
                  fileNames="script.xml"
                  patterns="script_*.xml"/>

        <lang.parserDefinition language="ThemeDSL"
                               implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslParserDefinition"/>

        <completion.contributor language="ThemeDSL"
                                implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslElementNameCompletionContributor"/>

        <completion.contributor language="ThemeDSL"
                                implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslAttributeCompletionContributor"/>

        <fileType name="DslExpression"
                  implementationClass="com.huawei.theme.analysis.plugin.editor.DslExpressionFileType"
                  fieldName="INSTANCE"
                  language="DslExpression"
                  extensions="de"/>

        <lang.parserDefinition language="DslExpression"
                               implementationClass="com.huawei.theme.analysis.plugin.editor.DslExpressionParserDefinition"/>

        <lang.parserDefinition language="VarName"
                               implementationClass="com.huawei.theme.analysis.plugin.editor.VarNameParserDefinition"/>

        <completion.contributor language="DslExpression"
                                implementationClass="com.huawei.theme.analysis.plugin.editor.DslExpressionCompletionContributor"/>

        <lang.documentationProvider language="DslExpression"
                                     implementationClass="com.huawei.theme.analysis.plugin.editor.DslExpressionDocumentationProvider"/>

        <lang.syntaxHighlighterFactory language="DslExpression"
                                implementationClass="com.huawei.theme.analysis.plugin.editor.DslExpressionSyntaxHighlighterFactory"/>

        <colorSettingsPage implementation="com.huawei.theme.analysis.plugin.editor.DslExpressionColorSettingsPage"/>

        <annotator language="DslExpression"
                   implementationClass="com.huawei.theme.analysis.plugin.editor.DslExpressionSemanticAnnotator"/>

        <annotator language="ThemeDSL"
                   implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslDiagnosticAnnotator"/>

        <lang.documentationProvider language="ThemeDSL"
                                     implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslTagDocumentationProvider"/>
        <lang.documentationProvider language="ThemeDSL"
                                     implementationClass="com.huawei.theme.analysis.plugin.editor.ThemeDslAttributeDocumentationProvider"/>

        <renamePsiElementProcessor implementation="com.huawei.theme.analysis.plugin.editor.ThemeDslVarRenameProcessor"/>

        <findUsagesHandlerFactory implementation="com.huawei.theme.analysis.plugin.editor.ThemeDslVarFindUsagesHandlerFactory"/>

        <psi.referenceContributor implementation="com.huawei.theme.analysis.plugin.editor.ThemeDslVariableReferenceContributor"
                                  language="ThemeDSL"/>

        <multiHostInjector implementation="com.huawei.theme.analysis.plugin.editor.ThemeDslExpressionInjector"/>
        <multiHostInjector implementation="com.huawei.theme.analysis.plugin.editor.ThemeDslVarNameInjector"/>
    </extensions>
</idea-plugin>
