<idea-plugin>
    <id>com.huawei.theme.analysis</id>
    <name>ThemeDevStudio Analysis</name>
    <vendor email="support@huawei.com" url="https://www.huawei.com">Huawei</vendor>

    <description><![CDATA[
    DSL static analysis tool for Huawei Theme Engine.<br>
    Provides syntax and semantic inspection, quick fix, and batch checking capabilities.
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.huawei.theme.analysis.DslAnalysisService"/>
        <language id="Dsl" implementationClass="com.huawei.theme.analysis.syntax.DslLanguage"/>
        <parserDefinition language="Dsl" implementationClass="com.huawei.theme.analysis.syntax.DslParserDefinition"/>
        <languageSubstitutor language="XML" implementationClass="com.huawei.theme.analysis.syntax.DslLanguageSubstitutor"/>
        <annotator language="Dsl" implementationClass="com.huawei.theme.analysis.syntax.DslSyntaxAnnotator"/>
    </extensions>
</idea-plugin>
